<h1>My Wishlist</h1>

<p><%= link_to "Back to Products", products_path %></p>

<% if @wishlist.products.any? %>
  <ul>
    <% @wishlist.products.each do |product| %>
      <li>
        <%= link_to product.name, product %>
        <%= button_to "Remove", remove_product_user_wishlist_path(@user, product_id: product.id), method: :delete, data: { turbo_confirm: "Remove from wishlist?" } %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>Your wishlist is empty. Start adding products!</p>
<% end %>

<%= button_to "Delete Wishlist", user_wishlist_path(@user), method: :delete, data: { turbo_confirm: "Are you sure you want to delete your entire wishlist?" } %>
